doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title jsondb — Playground & Roadmap
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css")
    link(rel="stylesheet" href="/stylesheets/style.css")
  body
    section.hero.is-small(style="background-color: #f2f2f2; border-bottom: 1px solid #e0e0e0;")
      .hero-body
        .level.is-mobile
          .level-left
            .level-item.mr-4
              figure.image.is-96x96
                img(src="/img/logo.webp" alt="jsondb logo")
            .level-item
              .has-text-left
                h1.title.is-2.is-spaced.has-text-weight-bold.has-text-dark.mb-2 jsondb
                p.subtitle.is-5.has-text-grey-dark.mt-0 Embedded, modular, and minimalist SQL engine

    section.section
      .columns
        .column.is-8
          .box.is-shadowless.border-box
            h2.title.is-6.has-text-weight-semibold SQL Console
            .field
              .control
                textarea#sqlInput.textarea(rows="5" placeholder="e.g., CREATE DATABASE school; USE school; CREATE TABLE students (id INT PRIMARY KEY AUTO_INCREMENT, name STRING);")
            .field
              .control
                button#runBtn.button.is-dark.is-small Execute Query

            .mt-5
              h3.title.is-6.has-text-weight-semibold.mb-2 Output
              pre#outputJson.is-size-7 Awaiting command...

        .column.is-4
          .box.is-shadowless.has-background-white-ter
            h2.title.is-6.has-text-weight-semibold Evolution & Roadmap
            .content.is-small.mt-3
              p
                strong Current Status: 
                | Core engine (`DatabaseEngine`), Parser, atomic Storage, and FIFO Queue validated by tests.
              hr.my-3
              p.has-text-weight-semibold Upcoming Features:
              ul
                li
                  span.has-text-success [Done] 
                  | Core Engine & Native Tests
                li
                  span.has-text-warning [In Progress] 
                  | Thin Express API & Bulma UI
                li
                  span.has-text-grey-light [Planned] 
                  | Indexing System (`.index.json`)
                li
                  span.has-text-grey-light [Planned] 
                  | JOIN Support (INNER JOIN)

    script.
      document.getElementById('runBtn').addEventListener('click', async () => {
        const sql = document.getElementById('sqlInput').value;
        const outputEl = document.getElementById('outputJson');
        outputEl.textContent = 'Executing...';

        try {
          const response = await fetch('/api/query', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sql })
          });
          const data = await response.json();
          outputEl.textContent = JSON.stringify(data, null, 2);
        } catch (err) {
          outputEl.textContent = 'Request error: ' + err.message;
        }
      });